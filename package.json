{
  "name": "tracktorr",
  "private": true,
  "type": "module",
  "workspaces": ["packages/client", "packages/server"],
  "scripts": {
    "dev": "npm run build:streamer && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "build:streamer": "cd packages/streamer && go build -o ../../dist/streamer.exe .",
    "build": "npm run build:streamer && npm run build -w packages/server && npm run build -w packages/client",
    "start": "npm run start -w packages/server",
    "start:docker": "node packages/server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
